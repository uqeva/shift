{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // `dom` because `page.evaluate` callbacks run in the page. Kept out of the
    // root project on purpose: there it would put `document` in scope for the
    // Edge Function and every node-side test too.
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    // The E2E files import each other by their `.ts` path, which Playwright's
    // loader and Node's own type stripping (`utils/require-stack.ts`, run
    // directly by `playwright.config.ts`) both resolve.
    "allowImportingTsExtensions": true,
    // Story 17.3: `reminder-delivery.spec.ts` runs `remind`'s own handler,
    // which imports the domain by its bare specifier. Checked against the
    // source, as the root project maps it; at run time Playwright resolves it
    // through the root `tsconfig.json`, the handler's nearest.
    "paths": {
      "@shift/domain": ["../packages/domain/src/index.ts"]
    }
  },
  "//": "The E2E suite's project, run by the root `typecheck` script. Separate from the root tsconfig only for the `dom` lib.",
  "include": ["**/*.ts", "../playwright.config.ts"]
}
