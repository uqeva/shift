# Environment for the Edge Functions, admin-auth, notify, calendar-feed and
# remind (AD-14; calendar-feed reads SUPABASE_URL and SHIFT_PUBLISHABLE_KEY
# only; remind reads SUPABASE_URL, SHIFT_SECRET_KEY and REMIND_INVOKE_SECRET
# only).
# Copy, do not edit in place:
#
#   cp supabase/functions/.env.example supabase/functions/.env
#
# `supabase functions serve` reads supabase/functions/.env by default, and
# `supabase secrets set --env-file <file>` pushes one of these per environment.
# Every real copy is gitignored — only this template is committed.
#
# NEVER commit a real key, and never paste one on a command line: an argument
# lands in shell history, an env file does not. See DEPLOY.md §3.
#
# SUPABASE_URL is NOT listed here: the Edge Runtime injects it, and the
# `SUPABASE_` prefix is reserved so it cannot be set as a secret anyway. Locally
# `supabase functions serve` injects it too.

# The secret key (`sb_secret_...`) for this environment, and the only place in
# the system it exists (AD-17). Replace the placeholder; do not lengthen it.
SHIFT_SECRET_KEY=sb_secret_...

# The publishable key (`sb_publishable_...`) for the same environment. The
# function needs it to build the caller-scoped client that carries the caller's
# JWT, so RLS and attribution still apply to every domain-table write.
SHIFT_PUBLISHABLE_KEY=sb_publishable_...

# Comma-separated exact origins allowed to call this function. An origin not on
# this list receives no Access-Control-Allow-* header and the browser refuses
# the response. Set it to the Pages hostname(s) for this environment. Required:
# left empty, the function answers every request 500 ALLOWED_ORIGINS_MISSING.
SHIFT_ALLOWED_ORIGINS=http://127.0.0.1:5173

# ---------------------------------------------------------------- notify only
# Read by supabase/functions/notify and nothing else (AD-17, amended). It also
# reads SHIFT_SECRET_KEY above, for its three RPCs only.

# The bearer token the `notify` cron job sends, from the Vault secret
# `notify_invoke_secret` (DEPLOY.md §3a). At least 32 characters; generate it
# with `openssl rand -hex 32`. The same value goes into Vault and here.
NOTIFY_INVOKE_SECRET=

# The Resend API key (`re_...`) for this environment's sending domain.
RESEND_API_KEY=re_...

# The sender, on a domain verified in Resend (SPF and DKIM, DEPLOY.md §3a).
# For example: Shift <obavijesti@example.org>
NOTIFY_EMAIL_FROM=

# The app's origin. An email links to a surface under it, e.g. /godisnji.
SHIFT_APP_URL=http://127.0.0.1:5173

# Story 10.4: the VAPID key pair a push is signed with, and its subject.
# Generate the pair once per environment (DEPLOY.md §3a):
#
#   pnpm dlx web-push@3.6.7 generate-vapid-keys
#
# The private key (43 characters) lives here and nowhere else (AD-17). The
# public key (87 characters) is also the SPA's build-time public key: the two
# must be the same pair, or every push service refuses the send.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Who a push service may contact: mailto:addr or an https URL.
VAPID_SUBJECT=mailto:obavijesti@example.org

# ---------------------------------------------------------------- remind only
# Read by supabase/functions/remind and nothing else (story 17.2; AD-17). It
# also reads SHIFT_SECRET_KEY above, for its two RPCs only.

# The bearer token the `remind` cron job sends, from the Vault secret
# `remind_invoke_secret` (DEPLOY.md §3b arms the job; until Vault holds it and
# `remind_url`, the job sends nothing). At least 32 characters, NOT notify's;
# generate it with `openssl rand -hex 32`. The same value goes into Vault and
# here. Locally `node scripts/ci/write-local-env.mjs` writes a fresh one
# (story 17.3), which the E2E stores in the local Vault for its own run.
REMIND_INVOKE_SECRET=
