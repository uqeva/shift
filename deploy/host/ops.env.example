# /etc/shift-ops/<env>.env (root, 0600): one stack's settings for shift-ops
# (stories 20.7, 20.8; DEPLOY.md §9.12, §9.13). KEY=VALUE lines, read as data,
# never sourced. Keep the real file OFF the repository: the repository is
# public, and the service id belongs to this host.

# Coolify's id of the stack's compose service (the suffix of its container
# names, e.g. supabase-db-<id>). Required.
SERVICE_UUID=<coolify service id>

# Defaults, shown for reference:
# DB_CONTAINER=supabase-db-<SERVICE_UUID>
# Volumes tarred into every set, as <SERVICE_UUID>_<suffix>. db-config holds
# pgsodium's root key, which Vault's secrets are encrypted under; storage-data
# holds the uploaded logos. The database's own volume is NOT tarred: a file
# copy of a running cluster is inconsistent; the dump is its copy.
# BACKUP_VOLUMES=supabase-db-config supabase-storage-data
# BACKUP_DIR=/var/backups/shift/<env>
# KEEP_DAILY=7
# KEEP_WEEKLY=4
# KEEP_MANUAL=5
# WEEKLY_DAY=7            (1 Monday .. 7 Sunday, in BACKUP_TZ)
# BACKUP_TZ=Europe/Zagreb
# DRILL_MEMORY=1g

# The off-host copy (H-11): OFF until the founder has a bucket and a key.
# To turn it on: install rclone (a pinned release), write RCLONE_CONFIG (root,
# 0600) as DEPLOY.md §9.12 shows, then set the three lines below instead.
# OFFSITE=rclone
# RCLONE_REMOTE=shift-offsite:<bucket>/<env>
# RCLONE_CONFIG=/etc/shift-ops/rclone.conf
OFFSITE=off

# jobs-check (20.8): <cron job>:<minutes since its last success>, the window
# for failed pg_net calls, how many in it fail the check, and the newest daily
# set's maximum age in hours (0: not checked).
# JOBS=notify:10 remind:20 housekeeping:1560
# JOBS_WINDOW_MINUTES=20
# JOBS_MAX_FAILED_CALLS=2
# BACKUP_MAX_AGE_HOURS=26
# The disk under the backups and under Docker, at most this percent used
# (0: not checked); and how often a failure that stays the same is repeated.
# DISK_MAX_PERCENT=85
# ALERT_REPEAT_HOURS=6
