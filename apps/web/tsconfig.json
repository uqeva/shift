{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "noEmit": true,
    // Story 21.27: `src/lib/auth-email.ts` imports `./email-layout.ts` by its
    // file name, so `scripts/auth-email-templates.mjs` can run it in Node.
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@/*": ["./src/*"],
      "@shift/domain": ["../../packages/domain/src/index.ts"],
      "@shift/ics": ["../../packages/ics/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "vitest.config.ts"]
}
